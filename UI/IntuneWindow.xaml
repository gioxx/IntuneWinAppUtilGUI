<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Publish to Intune"
        Width="780" Height="860" MinWidth="700" MinHeight="560"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#F4F7FB"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">
    <!-- SHARED_RESOURCES -->

    <DockPanel Margin="14" LastChildFill="True">

        <!-- Header: mode, account, v1 limitations -->
        <Border DockPanel.Dock="Top" Padding="14,12" CornerRadius="8"
                Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton Name="ModeNew" Content="New app" GroupName="Mode" IsChecked="True" Margin="0,0,18,0" VerticalContentAlignment="Center"/>
                        <RadioButton Name="ModeUpdate" Content="Update existing" GroupName="Mode" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Name="AccountText" Text="Not signed in" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Name="InstallGraphButton" Content="Install now" Width="104" Margin="0,0,8,0" Visibility="Collapsed"/>
                        <Button Name="SignInButton" Content="Sign in" Width="104"/>
                    </StackPanel>
                </Grid>
                <TextBlock Name="GraphStatusText" Style="{StaticResource HelpTextStyle}" MaxWidth="720" Visibility="Collapsed"/>
                <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="6"
                        Background="{StaticResource SoftPanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                    <TextBlock Name="LimitsText" Style="{StaticResource HelpTextStyle}" Margin="0" MaxWidth="720"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Footer: validation, status, progress, actions -->
        <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="14,12" CornerRadius="8"
                Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Name="ValidationText" TextWrapping="Wrap" FontSize="12" Foreground="#9F2424" Margin="0,0,0,8" Visibility="Collapsed"/>
                <TextBlock Name="StatusText" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8" Visibility="Collapsed"/>
                <StackPanel Name="ProgressPanel" Margin="0,0,0,8" Visibility="Collapsed">
                    <TextBlock Name="ProgressText" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                    <ProgressBar Name="UploadProgress" Height="8" Margin="0,4,0,0" Minimum="0" Maximum="100"/>
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontSize="12">
                        <Hyperlink Name="OpenInIntune" IsEnabled="False" ToolTip="Open this app in the Intune admin center">Open in Intune</Hyperlink>
                    </TextBlock>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Name="RetryUploadButton" Content="Retry upload" Width="104" Margin="0,0,8,0" Visibility="Collapsed"/>
                        <Button Name="UploadButton" Content="Upload" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" IsEnabled="False"/>
                        <Button Name="CloseButton" Content="Close" Width="104"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Form -->
        <Border Margin="0,10,0,0" CornerRadius="8"
                Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,12">
                <StackPanel Name="FormPanel">

                    <StackPanel Name="SearchPanel" Margin="0,0,0,16" Visibility="Collapsed">
                        <TextBlock Text="Find the app" Style="{StaticResource SectionTitleStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Name="SearchBox" ToolTip="Part of the app name; leave it empty to list every Win32 app"/>
                            <Button Name="SearchButton" Grid.Column="1" Content="Search" Width="104" Margin="8,0,0,0"/>
                        </Grid>
                        <ListBox Name="SearchResults" Height="120" Margin="0,6,0,0"/>
                    </StackPanel>

                    <TextBlock Text="Package" Style="{StaticResource SectionTitleStyle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Name="PackagePath" IsReadOnly="True"/>
                        <Button Name="BrowsePackage" Grid.Column="1" Content="Browse" Width="104" Margin="8,0,0,0"/>
                    </Grid>
                    <CheckBox Name="UploadContent" Content="Upload the package content" IsChecked="True" Margin="0,8,0,16"/>

                    <TextBlock Text="App information" Style="{StaticResource SectionTitleStyle}"/>
                    <Label Content="Name *"/>
                    <TextBox Name="DisplayName" Margin="0,4,0,8"/>
                    <Label Content="Publisher *"/>
                    <TextBox Name="Publisher" Margin="0,4,0,8"/>
                    <Label Content="Version"/>
                    <TextBox Name="DisplayVersion" Margin="0,4,0,8"/>
                    <Label Content="Description *"/>
                    <TextBox Name="Description" Margin="0,4,0,16" Height="64" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>

                    <TextBlock Text="Program" Style="{StaticResource SectionTitleStyle}"/>
                    <Label Content="Install command *"/>
                    <TextBox Name="InstallCommandLine" Margin="0,4,0,8"/>
                    <Label Content="Uninstall command *"/>
                    <TextBox Name="UninstallCommandLine" Margin="0,4,0,8"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <Label Content="Install behavior"/>
                            <ComboBox Name="RunAsAccount" Margin="0,4,0,0" MinHeight="31">
                                <ComboBoxItem Content="System" Tag="system" IsSelected="True"/>
                                <ComboBoxItem Content="User" Tag="user"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Label Content="Device restart behavior"/>
                            <ComboBox Name="DeviceRestartBehavior" Margin="0,4,0,0" MinHeight="31">
                                <ComboBoxItem Content="Determine behavior based on return codes" Tag="basedOnReturnCode" IsSelected="True"/>
                                <ComboBoxItem Content="No specific action" Tag="suppress"/>
                                <ComboBoxItem Content="App install may force a device restart" Tag="allow"/>
                                <ComboBoxItem Content="Intune will force a mandatory device restart" Tag="force"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <Label Content="Max run time (min) *"/>
                            <TextBox Name="MaxRunTimeInMinutes" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Requirements" Style="{StaticResource SectionTitleStyle}"/>
                    <Label Content="Architecture *"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,8">
                        <CheckBox Name="ArchX64" Content="x64" Margin="0,0,16,0"/>
                        <CheckBox Name="ArchX86" Content="x86" Margin="0,0,16,0"/>
                        <CheckBox Name="ArchArm64" Content="arm64"/>
                    </StackPanel>
                    <Label Content="Minimum Windows release"/>
                    <ComboBox Name="MinimumWindowsRelease" Width="150" HorizontalAlignment="Left" Margin="0,4,0,16" MinHeight="31"/>

                    <TextBlock Text="Detection rules" Style="{StaticResource SectionTitleStyle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ListBox Name="RulesList" Height="90"/>
                        <Button Name="RemoveRuleButton" Grid.Column="1" Content="Remove" Width="104" Margin="8,0,0,0" VerticalAlignment="Top"/>
                    </Grid>
                    <Border Margin="0,8,0,0" Padding="10" CornerRadius="6"
                            Background="{StaticResource SoftPanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                        <StackPanel>
                            <Label Content="New rule"/>
                            <ComboBox Name="NewRuleType" Width="220" HorizontalAlignment="Left" Margin="0,4,0,8" MinHeight="31">
                                <ComboBoxItem Content="MSI product code" Tag="MsiProductCode" IsSelected="True"/>
                                <ComboBoxItem Content="File or folder" Tag="File"/>
                                <ComboBoxItem Content="Registry" Tag="Registry"/>
                                <ComboBoxItem Content="PowerShell script" Tag="Script"/>
                            </ComboBox>

                            <StackPanel Name="MsiRulePanel">
                                <Label Content="Product code"/>
                                <TextBox Name="RuleProductCode" Margin="0,4,0,0" ToolTip="Format: {GUID}"/>
                            </StackPanel>

                            <StackPanel Name="FileRulePanel" Visibility="Collapsed">
                                <Label Content="Folder path"/>
                                <TextBox Name="RuleFilePath" Margin="0,4,0,8" ToolTip="For example: C:\Program Files\Contoso"/>
                                <Label Content="File or folder name"/>
                                <TextBox Name="RuleFileName" Margin="0,4,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Name="RuleFileOperation" MinHeight="31">
                                        <ComboBoxItem Content="Exists" Tag="exists" IsSelected="True"/>
                                        <ComboBoxItem Content="Version is at least" Tag="version"/>
                                    </ComboBox>
                                    <TextBox Name="RuleFileValue" Grid.Column="2" ToolTip="Version to compare, for example 1.2.3.4"/>
                                </Grid>
                                <CheckBox Name="RuleFile32Bit" Content="Associated with a 32-bit app on 64-bit clients" Margin="0,8,0,0"/>
                            </StackPanel>

                            <StackPanel Name="RegistryRulePanel" Visibility="Collapsed">
                                <Label Content="Key path"/>
                                <TextBox Name="RuleKeyPath" Margin="0,4,0,8" ToolTip="For example: HKEY_LOCAL_MACHINE\SOFTWARE\Contoso"/>
                                <Label Content="Value name (empty = check the key)"/>
                                <TextBox Name="RuleValueName" Margin="0,4,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Name="RuleRegOperation" MinHeight="31">
                                        <ComboBoxItem Content="Exists" Tag="exists" IsSelected="True"/>
                                        <ComboBoxItem Content="String equals" Tag="string"/>
                                        <ComboBoxItem Content="Version is at least" Tag="version"/>
                                    </ComboBox>
                                    <TextBox Name="RuleRegValue" Grid.Column="2" ToolTip="Value to compare"/>
                                </Grid>
                                <CheckBox Name="RuleReg32Bit" Content="Associated with a 32-bit app on 64-bit clients" Margin="0,8,0,0"/>
                            </StackPanel>

                            <StackPanel Name="ScriptRulePanel" Visibility="Collapsed">
                                <Label Content="Script file (.ps1, max 200 KB)"/>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Name="RuleScriptPath"/>
                                    <Button Name="BrowseScript" Grid.Column="1" Content="Browse" Width="104" Margin="8,0,0,0"/>
                                </Grid>
                                <CheckBox Name="RuleScriptRunAs32" Content="Run script as 32-bit process on 64-bit clients" Margin="0,8,0,0"/>
                                <CheckBox Name="RuleScriptSignature" Content="Enforce script signature check" Margin="0,4,0,0"/>
                            </StackPanel>

                            <TextBlock Name="RuleErrorText" TextWrapping="Wrap" FontSize="12" Foreground="#9F2424" Margin="0,8,0,0" Visibility="Collapsed"/>
                            <Button Name="AddRuleButton" Content="Add rule" Width="104" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
